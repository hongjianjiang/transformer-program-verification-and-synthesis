alphabet a b

bos_input = bos
symbol_0 = symbol a
symbol_1 = symbol b
node_0 = rightmost(symbol_1@i, bos_input@j)
node_1 = leftmost((true | false) & (node_0@j | symbol_1@i), node_0@j)
node_2 = rightmost(symbol_0@i | (node_0@j | node_1@j), !node_1@i)
node_5 = node_2 | (bos_input | node_0)

output node_5
