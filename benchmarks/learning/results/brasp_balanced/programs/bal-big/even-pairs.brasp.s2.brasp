alphabet a b

bos_input = bos
symbol_0 = symbol a
symbol_1 = symbol b
node_0 = leftmost(!bos_input@j & (true & true), !symbol_1@j & !bos_input@j)
node_1 = rightmost((symbol_1@i | bos_input@i) | node_0@j & symbol_0@i, !(symbol_1@i & node_0@i))
node_2 = leftmost(!bos_input@j, !bos_input@j | (true | bos_input@i))
node_5 = !node_2 | node_1 & node_2

output node_5
