alphabet a b

bos_input = bos
symbol_0 = symbol a
symbol_1 = symbol b
node_0 = symbol_1
node_1 = leftmost(symbol_0@j | symbol_1@j, node_0@j | symbol_1@j & symbol_0@i)
node_2 = rightmost(!bos_input@i, bos_input@j)
node_3 = node_1 | (symbol_1 | symbol_1)
node_4 = node_1 & symbol_1
node_5 = (node_4 | node_2) | !node_3

output node_5
