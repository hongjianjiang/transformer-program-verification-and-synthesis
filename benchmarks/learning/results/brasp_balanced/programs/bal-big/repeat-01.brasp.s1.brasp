alphabet a b

bos_input = bos
symbol_0 = symbol a
symbol_1 = symbol b
node_0 = rightmost(symbol_0@i, symbol_0@j | bos_input@j)
node_1 = rightmost(node_0@j & symbol_0@j | symbol_1@i & true, (bos_input@j | node_0@i) | symbol_1@j & symbol_1@i)
node_2 = rightmost(node_1@j, symbol_1@i)
node_3 = node_1 | symbol_0
node_5 = !(node_3 | node_2)

output node_5
