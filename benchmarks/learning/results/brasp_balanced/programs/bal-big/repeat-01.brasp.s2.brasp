alphabet a b

bos_input = bos
symbol_0 = symbol a
symbol_1 = symbol b
node_0 = rightmost(!bos_input@i, !symbol_0@j | !true)
node_1 = (bos_input & node_0) & symbol_1
node_2 = rightmost(!(node_1@i & true), (node_0@j | node_1@j) & !false)
node_3 = leftmost(symbol_0@j & node_2@j | node_0@i, !(symbol_1@i & node_1@j))
node_5 = !(node_3 | symbol_0)

output node_5
