alphabet a b

bos_input = bos
symbol_0 = symbol a
symbol_1 = symbol b
node_0 = rightmost(symbol_1@j, symbol_0@i)
node_1 = rightmost(!(node_0@j | symbol_1@j), bos_input@j)
node_3 = leftmost((symbol_0@i | node_0@j) & node_1@j, symbol_0@j)
node_4 = rightmost(symbol_0@j | node_0@i, !node_3@i)
node_5 = !node_4

output node_5
