logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!(((!(is_a@i) & is_a@j & !(is_b@j)) | (!(is_a@i) & !(is_b@j))))) S ((((!(is_a@i) & is_a@j & !(is_b@j)) | (!(is_a@i) & !(is_b@j))) & ((!(is_a@i) & is_b@i & is_bos@j & !(is_a@j)) | (!(is_a@i) & is_b@i & !(is_a@j) & is_b@j))))
accept := (!(is_bos@i) & !(h1_1@i))

output := accept@i
evaluate at i = |w| (the final input position)