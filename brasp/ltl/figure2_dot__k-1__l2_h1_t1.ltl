logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!((is_b@i & !(is_b@j)))) S (((is_b@i & !(is_b@j)) & (is_b@i & !(is_a@j))))
h2_1 := (!((!(h1_1@i) & !(is_b@j) & !(h1_1@j)))) S (((!(h1_1@i) & !(is_b@j) & !(h1_1@j)) & true))
accept := (!(h1_1@i) & h2_1@i)

output := accept@i
evaluate at i = |w| (the final input position)