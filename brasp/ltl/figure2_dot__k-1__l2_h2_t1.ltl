logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!((is_b@i & !(is_b@j)))) S (((is_b@i & !(is_b@j)) & (!(is_a@i) & is_b@i & !(is_a@j))))
h1_2_seen := (!(true)) S ((true & true))
h1_2_first := !(h1_2_seen@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & true))
h1_2 := h1_2_at@i
h2_1 := (!((!(is_a@i) & is_b@i & h1_1@i))) S (((!(is_a@i) & is_b@i & h1_1@i) & (!(is_a@i) & is_b@i & h1_1@i & !(is_a@j))))
h2_2_seen := (!((!(h1_2@j) & !(is_b@j) & h1_1@j & is_a@j & is_bos@j))) S (((!(h1_2@j) & !(is_b@j) & h1_1@j & is_a@j & is_bos@j) & true))
h2_2_first := (!(h1_2@i) & !(h2_2_seen@i) & !(is_b@i) & h1_1@i & is_a@i & is_bos@i)
h2_2_at := (!(h2_2_first@j)) S ((h2_2_first@j & (is_bos@i & !(is_a@i) & is_b@i & h1_1@i & !(h1_2@i) & !(is_bos@j) & is_a@j & is_b@j & h1_1@j & h1_2@j)))
h2_2 := (!(h1_2@i) & !(is_b@i) & h1_1@i & h2_2_at@i & is_a@i & is_bos@i)
accept := (!(is_bos@i) & !(h1_1@i) & !(h2_1@i) & !(h2_2@i))

output := accept@i
evaluate at i = |w| (the final input position)