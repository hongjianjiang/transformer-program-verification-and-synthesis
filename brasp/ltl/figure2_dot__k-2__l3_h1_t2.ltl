logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!((!(is_bos@j) & is_a@j & !(is_b@j)))) S (((!(is_bos@j) & is_a@j & !(is_b@j)) & true))
h2_1 := (!(((is_bos@i & is_a@i & !(is_b@i) & h1_1@i & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j) | (!(is_bos@j) & is_a@j & !(is_b@j))))) S ((((is_bos@i & is_a@i & !(is_b@i) & h1_1@i & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j) | (!(is_bos@j) & is_a@j & !(is_b@j))) & (!(is_bos@j) | is_a@j)))
h3_1 := (!(((!(is_a@i) & is_b@i & h2_1@i & !(is_bos@j) & is_a@j & !(is_b@j)) | (!(is_bos@j) & !(is_a@j) & is_b@j & h1_1@j & h2_1@j)))) S ((((!(is_a@i) & is_b@i & h2_1@i & !(is_bos@j) & is_a@j & !(is_b@j)) | (!(is_bos@j) & !(is_a@j) & is_b@j & h1_1@j & h2_1@j)) & ((!(is_a@i) & is_b@i) | (!(is_a@j) & is_b@j))))
accept := ((h1_1@i & h2_1@i & h3_1@i) | (h2_1@i & h3_1@i))

output := accept@i
evaluate at i = |w| (the final input position)