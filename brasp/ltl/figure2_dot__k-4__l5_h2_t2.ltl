logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!((!(is_bos@j) & is_a@j & !(is_b@j)))) S (((!(is_bos@j) & is_a@j & !(is_b@j)) & ((!(is_bos@j) & is_a@j) | !(is_bos@j))))
h1_2_seen := (!(true)) S ((true & true))
h1_2_first := !(h1_2_seen@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & ((is_a@i & !(is_b@i)) | (is_a@i & !(is_b@i) & is_bos@j & !(is_a@j)))))
h1_2 := (!(is_b@i) & h1_2_at@i & is_a@i)
h2_1 := (!(((!(is_b@i) & h1_1@i & h1_2@i & !(is_bos@j) & !(is_a@j) & is_b@j & h1_1@j & !(h1_2@j)) | (!(is_a@i) & is_b@i & h1_1@i & !(h1_2@i) & !(is_bos@j) & is_a@j & !(is_b@j) & h1_2@j)))) S ((((!(is_b@i) & h1_1@i & h1_2@i & !(is_bos@j) & !(is_a@j) & is_b@j & h1_1@j & !(h1_2@j)) | (!(is_a@i) & is_b@i & h1_1@i & !(h1_2@i) & !(is_bos@j) & is_a@j & !(is_b@j) & h1_2@j)) & !(is_bos@j)))
h2_2_seen := (!((!(is_b@j) & !(is_bos@j) & h1_1@j & h1_2@j & is_a@j))) S (((!(is_b@j) & !(is_bos@j) & h1_1@j & h1_2@j & is_a@j) & true))
h2_2_first := (!(h2_2_seen@i) & !(is_b@i) & !(is_bos@i) & h1_1@i & h1_2@i & is_a@i)
h2_2_at := (!(h2_2_first@j)) S ((h2_2_first@j & true))
h2_2 := (h2_2_at@i & ((!(is_a@i) & !(is_b@i) & h1_1@i) | (!(is_a@i) & h1_1@i & is_b@i) | (h1_1@i & is_a@i)))
h3_1 := (!(((is_bos@i & !(is_a@i) & is_b@i & !(h1_1@i) & !(h1_2@i) & !(h2_1@i) & !(h2_2@i) & is_bos@j & !(is_a@j) & is_b@j & h1_1@j & h1_2@j & !(h2_1@j) & !(h2_2@j)) | (is_bos@i & !(is_a@i) & is_b@i & !(h1_1@i) & !(h1_2@i) & !(h2_1@i) & !(h2_2@i) & is_bos@j & is_a@j & is_b@j & !(h1_1@j) & !(h1_2@j) & h2_1@j & !(h2_2@j))))) S ((((is_bos@i & !(is_a@i) & is_b@i & !(h1_1@i) & !(h1_2@i) & !(h2_1@i) & !(h2_2@i) & is_bos@j & !(is_a@j) & is_b@j & h1_1@j & h1_2@j & !(h2_1@j) & !(h2_2@j)) | (is_bos@i & !(is_a@i) & is_b@i & !(h1_1@i) & !(h1_2@i) & !(h2_1@i) & !(h2_2@i) & is_bos@j & is_a@j & is_b@j & !(h1_1@j) & !(h1_2@j) & h2_1@j & !(h2_2@j))) & ((is_bos@i & !(h1_1@i) & !(h2_1@i) & !(h2_2@i) & is_bos@j & !(is_a@j) & is_b@j & !(h1_1@j) & h2_1@j & !(h2_2@j)) | (is_bos@i & is_a@i & !(is_b@i) & !(h1_1@i) & !(h1_2@i) & !(h2_1@i) & is_bos@j & is_a@j & !(is_b@j) & h1_1@j & h1_2@j & !(h2_1@j) & h2_2@j))))
h3_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & true))
h3_2 := (!(h2_1@i) & h3_2_at@i)
h4_1 := (!(((!(h3_1@i) & !(is_a@j) & !(h1_2@j) & !(h3_1@j)) | (!(h3_1@i) & !(h2_2@j) & !(h3_1@j))))) S ((((!(h3_1@i) & !(is_a@j) & !(h1_2@j) & !(h3_1@j)) | (!(h3_1@i) & !(h2_2@j) & !(h3_1@j))) & ((!(h2_1@i) & !(h2_1@j)) | (is_a@i & !(is_b@i) & h1_2@i & is_a@j & !(is_b@j) & h1_2@j))))
h4_2_seen := (!((!(is_b@j) & !(is_bos@j) & h1_1@j & h1_2@j & h2_1@j & h3_1@j & h3_2@j & is_a@j))) S (((!(is_b@j) & !(is_bos@j) & h1_1@j & h1_2@j & h2_1@j & h3_1@j & h3_2@j & is_a@j) & true))
h4_2_first := (!(h4_2_seen@i) & !(is_b@i) & !(is_bos@i) & h1_1@i & h1_2@i & h2_1@i & h3_1@i & h3_2@i & is_a@i)
h4_2_at := (!(h4_2_first@j)) S ((h4_2_first@j & ((h2_1@i & !(h3_1@i) & !(h3_2@i) & !(h3_1@j) & h3_2@j) | (h2_1@i & !(h3_1@i) & !(h3_2@i) & !(is_bos@j) & !(h3_1@j)))))
h4_2_seen_1 := (!((!(is_b@j) & !(is_bos@j) & h1_2@j & h2_1@j & is_a@j))) S (((!(is_b@j) & !(is_bos@j) & h1_2@j & h2_1@j & is_a@j) & true))
h4_2_first_1 := (!(h4_2_seen_1@i) & !(is_b@i) & !(is_bos@i) & h1_2@i & h2_1@i & is_a@i)
h4_2_at_1 := (!(h4_2_first_1@j)) S ((h4_2_first_1@j & ((h2_1@i & !(h3_1@i) & !(h3_2@i) & !(h3_1@j) & h3_2@j) | (h2_1@i & !(h3_1@i) & !(h3_2@i) & !(is_bos@j) & !(h3_1@j)))))
h4_2 := ((!(h3_2@i) & h2_1@i & h4_2_at_1@i) | (h1_1@i & h1_2@i & h2_1@i & h2_2@i & h3_1@i & h3_2@i & h4_2_at@i & is_a@i & is_b@i & is_bos@i))
h5_1 := (!(((h1_1@i & h1_2@i & !(h4_1@i) & h4_2@i & !(is_a@j) & is_b@j & !(h1_2@j) & h2_1@j & h2_2@j & !(h3_2@j) & !(h4_1@j) & h4_2@j) | (is_a@i & !(is_b@i) & h1_2@i & !(h3_1@i) & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j & h3_2@j & h4_1@j & !(h4_2@j))))) S ((((h1_1@i & h1_2@i & !(h4_1@i) & h4_2@i & !(is_a@j) & is_b@j & !(h1_2@j) & h2_1@j & h2_2@j & !(h3_2@j) & !(h4_1@j) & h4_2@j) | (is_a@i & !(is_b@i) & h1_2@i & !(h3_1@i) & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j & h3_2@j & h4_1@j & !(h4_2@j))) & ((is_a@i & is_a@j & !(is_b@j) & h1_1@j & h1_2@j & !(h3_1@j)) | (is_a@i & !(is_b@i) & h1_2@i & is_a@j & h1_2@j & !(h2_1@j) & h3_2@j & h4_1@j & !(h4_2@j)))))
accept := ((h1_1@i & h2_1@i & !(h3_1@i) & !(h3_2@i) & !(h4_1@i) & h4_2@i & !(h5_1@i)) | (!(is_bos@i) & h1_1@i & h2_1@i & !(h3_1@i) & !(h3_2@i) & !(h4_1@i) & h4_2@i & !(h5_1@i)))

output := accept@i
evaluate at i = |w| (the final input position)