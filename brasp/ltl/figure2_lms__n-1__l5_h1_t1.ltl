logic past-strict
alphabet b0 b1 sep

is_bos := bos@i
is_b0 := sym(b0)@i
is_b1 := sym(b1)@i
is_sep := sym(sep)@i
h1_1 := (!((!(is_sep@i) & !(is_bos@j) & !(is_b0@j)))) S (((!(is_sep@i) & !(is_bos@j) & !(is_b0@j)) & (!(is_bos@i) & !(is_sep@i) & !(is_bos@j) & !(is_b1@j) & is_sep@j)))
h2_1 := (!((!(is_bos@j) & !(is_b0@j) & is_b1@j & !(is_sep@j)))) S (((!(is_bos@j) & !(is_b0@j) & is_b1@j & !(is_sep@j)) & (!(is_b0@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & !(is_sep@j))))
h3_1 := (!((!(is_bos@i) & !(is_b0@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & !(is_sep@j) & h2_1@j))) S (((!(is_bos@i) & !(is_b0@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & !(is_sep@j) & h2_1@j) & (!(is_b0@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & !(is_sep@j) & !(h1_1@j))))
h4_1 := (!((!(h1_1@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & h1_1@j & h2_1@j & !(h3_1@j)))) S (((!(h1_1@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & h1_1@j & h2_1@j & !(h3_1@j)) & (h2_1@i & !(is_bos@j) & !(is_b0@j) & !(is_sep@j) & h1_1@j & h2_1@j)))
h5_1 := (!((!(h4_1@i) & !(is_bos@j) & !(is_sep@j) & !(h1_1@j) & !(h2_1@j) & !(h3_1@j)))) S (((!(h4_1@i) & !(is_bos@j) & !(is_sep@j) & !(h1_1@j) & !(h2_1@j) & !(h3_1@j)) & (!(h4_1@i) & !(is_bos@j) & !(h3_1@j) & !(h4_1@j))))
accept := (!(is_bos@i) & !(is_sep@i) & !(h3_1@i) & !(h4_1@i) & !(h5_1@i))

output := accept@i
evaluate at i = |w| (the final input position)