h2_2 := ((!(is_b1@i) & h1_1@i & h1_2@i & h2_2_at@i & is_b0@i & is_bos@i & is_sep@i) | (h2_2_at_1@i & ((!(is_b0@i) & !(is_bos@i) & h1_1@i & h1_2@i) | (!(is_b0@i) & h1_1@i & h1_2@i & is_bos@i))))
h3_1 := (!(((!(is_b0@i) & is_b1@i & h2_1@i & !(h2_2@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & h1_1@j & !(h2_1@j)) | (is_b0@i & !(is_b1@i) & h1_1@i & !(h1_2@i) & h2_1@i & !(is_bos@j) & !(is_b0@j) & !(is_b1@j) & is_sep@j & h1_1@j & !(h1_2@j) & !(h2_1@j) & !(h2_2@j))))) S ((((!(is_b0@i) & is_b1@i & h2_1@i & !(h2_2@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & h1_1@j & !(h2_1@j)) | (is_b0@i & !(is_b1@i) & h1_1@i & !(h1_2@i) & h2_1@i & !(is_bos@j) & !(is_b0@j) & !(is_b1@j) & is_sep@j & h1_1@j & !(h1_2@j) & !(h2_1@j) & !(h2_2@j))) & ((!(is_b0@i) & !(h1_1@i) & h1_2@i & !(is_bos@j) & !(is_b0@j) & is_b1@j) | (!(h2_2@i) & !(is_bos@j) & !(is_b0@j) & !(h1_2@j) & !(h2_1@j) & !(h2_2@j)))))
h3_2_seen := (!(((!(h1_2@j) & h2_1@j & h2_2@j & is_b0@j & is_bos@j & is_sep@j) | (!(h1_2@j) & h2_1@j & is_bos@j & is_sep@j)))) S ((((!(h1_2@j) & h2_1@j & h2_2@j & is_b0@j & is_bos@j & is_sep@j) | (!(h1_2@j) & h2_1@j & is_bos@j & is_sep@j)) & true))
h3_2_first := (!(h3_2_seen@i) & ((!(h1_2@i) & h2_1@i & h2_2@i & is_b0@i & is_bos@i & is_sep@i) | (!(h1_2@i) & h2_1@i & is_bos@i & is_sep@i)))
h3_2_at := (!(h3_2_first@j)) S ((h3_2_first@j & ((is_bos@i & !(is_b0@i) & is_sep@i & h1_1@i & !(h1_2@i) & !(h2_1@i) & h2_2@i & is_bos@j & !(is_b0@j) & is_sep@j & h2_1@j & h2_2@j) | (is_bos@i & is_b1@i & !(h1_1@i) & !(h1_2@i) & !(h2_1@i) & is_bos@j & is_b0@j & is_sep@j & h1_1@j))))
h3_2_seen_1 := (!((!(h1_2@j) & h2_1@j & h2_2@j & is_b0@j & is_bos@j & is_sep@j))) S (((!(h1_2@j) & h2_1@j & h2_2@j & is_b0@j & is_bos@j & is_sep@j) & true))
h3_2_first_1 := (!(h1_2@i) & !(h3_2_seen_1@i) & h2_1@i & h2_2@i & is_b0@i & is_bos@i & is_sep@i)
h3_2_at_1 := (!(h3_2_first_1@j)) S ((h3_2_first_1@j & ((is_bos@i & !(is_b0@i) & is_sep@i & h1_1@i & !(h1_2@i) & !(h2_1@i) & h2_2@i & is_bos@j & !(is_b0@j) & is_sep@j & h2_1@j & h2_2@j) | (is_bos@i & is_b1@i & !(h1_1@i) & !(h1_2@i) & !(h2_1@i) & is_bos@j & is_b0@j & is_sep@j & h1_1@j))))
h3_2 := ((!(is_bos@i) & h1_1@i & h1_2@i & h2_1@i & h2_2@i & h3_2_at_1@i & is_b0@i & is_b1@i & is_sep@i) | (h1_1@i & h1_2@i & h2_1@i & h2_2@i & h3_2_at@i & is_b0@i & is_b1@i & is_bos@i & is_sep@i))
h4_1 := (!(((!(h2_2@j) & !(h3_1@j)) | (!(h3_1@i) & !(h3_2@i) & !(h2_2@j) & !(h3_1@j))))) S ((((!(h2_2@j) & !(h3_1@j)) | (!(h3_1@i) & !(h3_2@i) & !(h2_2@j) & !(h3_1@j))) & (!(h2_1@j) | (!(h1_2@i) & !(h2_1@i) & !(h2_2@i) & !(h3_1@i) & !(is_b0@j) & !(h1_2@j) & !(h3_1@j)))))
