logic past-strict
alphabet b0 b1 sep

is_bos := bos@i
is_b0 := sym(b0)@i
is_b1 := sym(b1)@i
is_sep := sym(sep)@i
h1_1 := (!(((!(is_b0@i) & is_b1@i & !(is_b1@j)) | (!(is_b0@i) & is_sep@i & !(is_sep@j))))) S ((((!(is_b0@i) & is_b1@i & !(is_b1@j)) | (!(is_b0@i) & is_sep@i & !(is_sep@j))) & (!(is_b0@i) & !(is_b1@j) & !(is_sep@j))))
h1_2_seen := (!((!(is_b1@j) & !(is_bos@j) & !(is_sep@j) & is_b0@j))) S (((!(is_b1@j) & !(is_bos@j) & !(is_sep@j) & is_b0@j) & true))
h1_2_first := (!(h1_2_seen@i) & !(is_b1@i) & !(is_bos@i) & !(is_sep@i) & is_b0@i)
