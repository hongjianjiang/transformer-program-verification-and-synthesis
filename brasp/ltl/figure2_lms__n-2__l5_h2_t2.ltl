h1_2_first_1 := (!(h1_2_seen_1@i) & !(is_bos@i) & !(is_sep@i))
h1_2_at_1 := (!(h1_2_first_1@j)) S ((h1_2_first_1@j & ((!(is_bos@j) & is_b0@j & !(is_b1@j) & !(is_sep@j)) | (!(is_b1@i) & !(is_bos@j) & is_b0@j & !(is_b1@j) & !(is_sep@j)))))
h1_2_seen_2 := (!(((!(is_b1@j) & !(is_bos@j) & !(is_sep@j) & is_b0@j) | (!(is_bos@j) & !(is_sep@j))))) S ((((!(is_b1@j) & !(is_bos@j) & !(is_sep@j) & is_b0@j) | (!(is_bos@j) & !(is_sep@j))) & true))
h1_2_first_2 := (!(h1_2_seen_2@i) & ((!(is_b1@i) & !(is_bos@i) & !(is_sep@i) & is_b0@i) | (!(is_bos@i) & !(is_sep@i))))
h1_2_at_2 := (!(h1_2_first_2@j)) S ((h1_2_first_2@j & ((!(is_bos@j) & is_b0@j & !(is_b1@j) & !(is_sep@j)) | (!(is_b1@i) & !(is_bos@j) & is_b0@j & !(is_b1@j) & !(is_sep@j)))))
h1_2 := ((!(is_b0@i) & !(is_sep@i) & h1_2_at_2@i & is_b1@i) | (!(is_b0@i) & h1_2_at@i & is_b1@i & is_sep@i) | (h1_2_at_1@i & ((!(is_b0@i) & !(is_b1@i) & !(is_sep@i)) | (!(is_sep@i) & is_b0@i))))
h2_1 := (!((!(is_sep@i) & !(is_bos@j)))) S (((!(is_sep@i) & !(is_bos@j)) & ((!(is_sep@i) & h1_2@i & !(is_bos@j) & is_b0@j & !(is_b1@j) & !(is_sep@j)) | (!(is_sep@i) & !(h1_1@i) & !(h1_2@i) & !(is_bos@j) & is_b1@j & !(is_sep@j) & !(h1_1@j)))))
h2_2_seen := (!((h1_1@j & h1_2@j & is_b0@j & is_b1@j & is_bos@j & is_sep@j))) S (((h1_1@j & h1_2@j & is_b0@j & is_b1@j & is_bos@j & is_sep@j) & true))
h2_2_first := (!(h2_2_seen@i) & h1_1@i & h1_2@i & is_b0@i & is_b1@i & is_bos@i & is_sep@i)
h2_2_at := (!(h2_2_first@j)) S ((h2_2_first@j & ((!(is_b0@i) & h1_1@i & !(is_bos@j) & is_b1@j & !(is_sep@j)) | (!(is_b0@i) & !(is_bos@j) & !(is_b0@j) & is_b1@j & !(is_sep@j)))))
h2_2_seen_1 := (!((!(h1_1@j) & !(is_b0@j) & h1_2@j & is_b1@j))) S (((!(h1_1@j) & !(is_b0@j) & h1_2@j & is_b1@j) & true))
h2_2_first_1 := (!(h1_1@i) & !(h2_2_seen_1@i) & !(is_b0@i) & h1_2@i & is_b1@i)
