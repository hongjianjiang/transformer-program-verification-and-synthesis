logic past-strict
alphabet a m

is_bos := bos@i
is_a := sym(a)@i
is_m := sym(m)@i
h1_1 := (!(!(is_a@j))) S ((!(is_a@j) & true))
h1_2_seen := (!((!(is_a@j) & is_m@j))) S (((!(is_a@j) & is_m@j) & true))
h1_2_first := (!(h1_2_seen@i) & !(is_a@i) & is_m@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & !(is_a@j)))
h1_2 := h1_2_at@i
accept := (!(is_bos@i) & h1_1@i & h1_2@i)

output := accept@i
evaluate at i = |w| (the final input position)