logic past-strict
alphabet a m

is_bos := bos@i
is_a := sym(a)@i
is_m := sym(m)@i
h1_1 := (!((is_a@i & !(is_m@i) & !(is_bos@j) & is_a@j & !(is_m@j)))) S (((is_a@i & !(is_m@i) & !(is_bos@j) & is_a@j & !(is_m@j)) & (is_a@i & !(is_m@i) & !(is_bos@j) & !(is_m@j))))
h2_1 := (!((is_a@i & !(is_a@j) & !(h1_1@j)))) S (((is_a@i & !(is_a@j) & !(h1_1@j)) & (is_a@i & !(is_m@i) & !(is_m@j))))
accept := (!(is_bos@i) & !(h2_1@i))

output := accept@i
evaluate at i = |w| (the final input position)