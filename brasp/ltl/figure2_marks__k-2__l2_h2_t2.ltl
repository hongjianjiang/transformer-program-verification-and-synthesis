logic past-strict
alphabet a m

is_bos := bos@i
is_a := sym(a)@i
is_m := sym(m)@i
h1_1 := (!(((is_a@i & !(is_m@i) & is_bos@j & !(is_a@j)) | !(is_a@j)))) S ((((is_a@i & !(is_m@i) & is_bos@j & !(is_a@j)) | !(is_a@j)) & ((is_a@i & !(is_m@j)) | (is_a@i & is_a@j & !(is_m@j)))))
h1_2_seen := (!((!(is_a@j) & !(is_bos@j) & is_m@j))) S (((!(is_a@j) & !(is_bos@j) & is_m@j) & true))
h1_2_first := (!(h1_2_seen@i) & !(is_a@i) & !(is_bos@i) & is_m@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & (!(is_a@j) & is_m@j)))
h1_2 := h1_2_at@i
h2_1 := (!((h1_1@i & !(h1_2@i)))) S (((h1_1@i & !(h1_2@i)) & true))
h2_2_seen := (!((!(is_bos@j) & h1_1@j))) S (((!(is_bos@j) & h1_1@j) & true))
h2_2_first := (!(h2_2_seen@i) & !(is_bos@i) & h1_1@i)
h2_2_at := (!(h2_2_first@j)) S ((h2_2_first@j & ((is_a@i & !(is_m@i) & h1_1@i & !(h1_2@i) & !(is_bos@j) & is_a@j & !(is_m@j)) | (is_a@i & !(is_m@i) & h1_1@i & !(h1_2@i) & !(is_m@j)))))
h2_2_seen_1 := (!((!(is_bos@j) | (!(is_bos@j) & h1_1@j)))) S (((!(is_bos@j) | (!(is_bos@j) & h1_1@j)) & true))
h2_2_first_1 := (!(h2_2_seen_1@i) & (!(is_bos@i) | (!(is_bos@i) & h1_1@i)))
h2_2_at_1 := (!(h2_2_first_1@j)) S ((h2_2_first_1@j & ((is_a@i & !(is_m@i) & h1_1@i & !(h1_2@i) & !(is_bos@j) & is_a@j & !(is_m@j)) | (is_a@i & !(is_m@i) & h1_1@i & !(h1_2@i) & !(is_m@j)))))
h2_2_seen_2 := (!(!(is_bos@j))) S ((!(is_bos@j) & true))
h2_2_first_2 := (!(h2_2_seen_2@i) & !(is_bos@i))
h2_2_at_2 := (!(h2_2_first_2@j)) S ((h2_2_first_2@j & ((is_a@i & !(is_m@i) & h1_1@i & !(h1_2@i) & !(is_bos@j) & is_a@j & !(is_m@j)) | (is_a@i & !(is_m@i) & h1_1@i & !(h1_2@i) & !(is_m@j)))))
h2_2 := ((!(h1_1@i) & !(is_a@i) & !(is_m@i) & h1_2@i & h2_2_at_2@i) | (!(h1_1@i) & !(is_m@i) & h1_2@i & h2_2_at_1@i & is_a@i) | (h2_2_at@i & ((!(h1_1@i) & !(h1_2@i) & !(is_m@i) & is_a@i) | (!(is_m@i) & h1_1@i & is_a@i))))
accept := (!(is_bos@i) & !(h1_1@i) & h1_2@i & !(h2_1@i) & !(h2_2@i))

output := accept@i
evaluate at i = |w| (the final input position)