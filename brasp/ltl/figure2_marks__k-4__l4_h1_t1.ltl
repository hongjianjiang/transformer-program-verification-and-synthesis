logic past-strict
alphabet a m

is_bos := bos@i
is_a := sym(a)@i
is_m := sym(m)@i
h1_1 := (!((!(is_bos@j) & !(is_a@j) & is_m@j))) S (((!(is_bos@j) & !(is_a@j) & is_m@j) & !(is_a@j)))
h2_1 := (!((h1_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & h1_1@j))) S (((h1_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & h1_1@j) & (h1_1@i & !(is_bos@j))))
h3_1 := (!((h1_1@i & h2_1@i & !(is_a@j) & is_m@j & h1_1@j & h2_1@j))) S (((h1_1@i & h2_1@i & !(is_a@j) & is_m@j & h1_1@j & h2_1@j) & !(is_bos@j)))
h4_1 := (!((!(h3_1@i) & !(is_m@j)))) S (((!(h3_1@i) & !(is_m@j)) & !(is_m@j)))
accept := (!(is_bos@i) & h3_1@i & !(h4_1@i))

output := accept@i
evaluate at i = |w| (the final input position)