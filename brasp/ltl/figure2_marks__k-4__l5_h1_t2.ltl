logic past-strict
alphabet a m

is_bos := bos@i
is_a := sym(a)@i
is_m := sym(m)@i
h1_1 := (!(((is_bos@i & !(is_a@i) & is_m@i & !(is_bos@j) & !(is_a@j) & is_m@j) | (!(is_bos@j) & !(is_a@j) & is_m@j)))) S ((((is_bos@i & !(is_a@i) & is_m@i & !(is_bos@j) & !(is_a@j) & is_m@j) | (!(is_bos@j) & !(is_a@j) & is_m@j)) & (!(is_bos@j) | (!(is_a@j) & is_m@j))))
h2_1 := (!(((!(is_m@i) & is_bos@j & !(is_a@j)) | !(is_a@j)))) S ((((!(is_m@i) & is_bos@j & !(is_a@j)) | !(is_a@j)) & (!(h1_1@i) & !(h1_1@j))))
h3_1 := (!(((!(is_a@i) & is_m@i & h1_1@i & !(h2_1@i) & !(is_bos@j) & !(is_a@j) & is_m@j & h1_1@j & !(h2_1@j)) | (h1_1@i & !(h2_1@i) & !(is_bos@j) & !(is_a@j) & is_m@j & h1_1@j & !(h2_1@j))))) S ((((!(is_a@i) & is_m@i & h1_1@i & !(h2_1@i) & !(is_bos@j) & !(is_a@j) & is_m@j & h1_1@j & !(h2_1@j)) | (h1_1@i & !(h2_1@i) & !(is_bos@j) & !(is_a@j) & is_m@j & h1_1@j & !(h2_1@j))) & true))
h4_1 := (!(((!(is_a@i) & is_m@i & h3_1@i) | (h1_1@i & !(h2_1@i) & h3_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & !(h2_1@j) & h3_1@j)))) S ((((!(is_a@i) & is_m@i & h3_1@i) | (h1_1@i & !(h2_1@i) & h3_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & !(h2_1@j) & h3_1@j)) & true))
h5_1 := (!(((!(h2_1@i) & h3_1@i & h4_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & h3_1@j & h4_1@j) | (is_m@i & h4_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & h4_1@j)))) S ((((!(h2_1@i) & h3_1@i & h4_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & h3_1@j & h4_1@j) | (is_m@i & h4_1@i & !(is_bos@j) & !(is_a@j) & is_m@j & h4_1@j)) & ((h3_1@i & h4_1@i) | (h3_1@i & h4_1@i & !(h2_1@j) & h3_1@j & h4_1@j))))
accept := ((h3_1@i & h4_1@i & h5_1@i) | (!(is_bos@i) & !(h2_1@i) & h3_1@i & h4_1@i & h5_1@i))

output := accept@i
evaluate at i = |w| (the final input position)