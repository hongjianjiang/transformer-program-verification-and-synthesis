logic past-strict
alphabet s0 s1

is_s0 := sym(s0)@i
is_s1 := sym(s1)@i
bad := (!(((is_s0@i & is_s0@j) | (is_s0@i & is_s1@j) | (is_s1@i & is_s1@j)))) S ((((is_s0@i & is_s0@j) | (is_s0@i & is_s1@j) | (is_s1@i & is_s1@j)) & true))
is_word := (is_s0@i | is_s1@i)
accept := (is_word@i & !(bad@i))

output := accept@i
evaluate at i = |w| (the final input position)