logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!((is_a@j & !(is_b@j)))) S (((is_a@j & !(is_b@j)) & (!(is_a@j) & is_b@j)))
h1_2_seen := (!((!(is_a@j) & !(is_bos@j) & is_b@j))) S (((!(is_a@j) & !(is_bos@j) & is_b@j) & true))
h1_2_first := (!(h1_2_seen@i) & !(is_a@i) & !(is_bos@i) & is_b@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & (is_b@i & !(is_a@j))))
h1_2 := (!(is_a@i) & h1_2_at@i & is_b@i)
h2_1 := (!((h1_1@i & h1_1@j))) S (((h1_1@i & h1_1@j) & (h1_1@i & !(is_a@j) & is_b@j & h1_1@j)))
h2_2_seen := (!((!(h1_1@j) & !(is_b@j) & !(is_bos@j) & is_a@j))) S (((!(h1_1@j) & !(is_b@j) & !(is_bos@j) & is_a@j) & true))
h2_2_first := (!(h1_1@i) & !(h2_2_seen@i) & !(is_b@i) & !(is_bos@i) & is_a@i)
h2_2_at := (!(h2_2_first@j)) S ((h2_2_first@j & (!(is_bos@j) & !(is_b@j))))
h2_2 := (!(h1_1@i) & !(h1_2@i) & !(is_b@i) & h2_2_at@i & is_a@i)
h3_1 := (!((!(h2_1@i) & !(is_bos@j) & is_a@j & !(is_b@j) & !(h2_1@j) & h2_2@j))) S (((!(h2_1@i) & !(is_bos@j) & is_a@j & !(is_b@j) & !(h2_1@j) & h2_2@j) & (is_a@j & !(h1_2@j) & !(h2_1@j))))
h3_2_seen := (!((!(h2_1@j) & !(is_b@j) & !(is_bos@j) & h2_2@j & is_a@j))) S (((!(h2_1@j) & !(is_b@j) & !(is_bos@j) & h2_2@j & is_a@j) & true))
h3_2_first := (!(h2_1@i) & !(h3_2_seen@i) & !(is_b@i) & !(is_bos@i) & h2_2@i & is_a@i)
h3_2_at := (!(h3_2_first@j)) S ((h3_2_first@j & is_a@j))
h3_2 := (!(h2_1@i) & h2_2@i & h3_2_at@i)
accept := (!(h3_1@i) & !(h3_2@i))

output := accept@i
evaluate at i = |w| (the final input position)