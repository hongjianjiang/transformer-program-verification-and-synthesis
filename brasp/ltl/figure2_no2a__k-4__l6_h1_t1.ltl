logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!((is_a@i & !(is_b@i) & !(is_bos@j) & is_a@j & !(is_b@j)))) S (((is_a@i & !(is_b@i) & !(is_bos@j) & is_a@j & !(is_b@j)) & (!(is_bos@j) & is_a@j & !(is_b@j))))
h2_1 := (!((!(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j))) S (((!(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j) & !(is_bos@j)))
h3_1 := (!((!(is_bos@j) & is_a@j & h1_1@j & h2_1@j))) S (((!(is_bos@j) & is_a@j & h1_1@j & h2_1@j) & (h2_1@i & !(is_b@j))))
h4_1 := (!((h2_1@i & !(is_bos@j) & !(is_a@j)))) S (((h2_1@i & !(is_bos@j) & !(is_a@j)) & !(is_bos@j)))
h5_1 := (!((h2_1@i & h4_1@i & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j & h2_1@j))) S (((h2_1@i & h4_1@i & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j & h2_1@j) & (is_a@j & !(is_b@j))))
h6_1 := (!((h2_1@i & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j & h2_1@j))) S (((h2_1@i & !(is_bos@j) & is_a@j & !(is_b@j) & h1_1@j & h2_1@j) & is_a@j))
accept := (!(h3_1@i) & !(h4_1@i) & !(h5_1@i) & !(h6_1@i))

output := accept@i
evaluate at i = |w| (the final input position)