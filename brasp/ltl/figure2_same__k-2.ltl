logic past-strict
alphabet a b m

is_m := sym(m)@i
is_a := sym(a)@i
is_b := sym(b)@i
prev_a := (!(true)) S ((true & is_a@j))
prev_b := (!(true)) S ((true & is_b@j))
prev_m := (!(true)) S ((true & is_m@j))
h_1 := is_m@i
p_2 := (!(is_m@j)) S ((is_m@j & h_1@j))
h_2 := (is_m@i & p_2@i)
accept := (!(h_2@j)) S ((h_2@j & ((is_a@i & prev_a@j) | (is_b@i & prev_b@j) | (is_m@i & prev_m@j))))

output := accept@i
evaluate at i = |w| (the final input position)