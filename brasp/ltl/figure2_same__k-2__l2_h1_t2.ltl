logic past-strict
alphabet a b m

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
is_m := sym(m)@i
h1_1 := (!(true)) S ((true & ((!(is_a@i) & !(is_b@i) & is_m@i & is_bos@j & !(is_a@j) & !(is_b@j)) | (!(is_m@i) & !(is_bos@j) & !(is_a@j) & !(is_b@j) & is_m@j))))
h2_1 := (!(!(is_m@i))) S ((!(is_m@i) & ((is_bos@i & is_a@i & is_b@i & is_m@i & h1_1@i & is_bos@j & !(is_a@j) & !(is_b@j) & !(h1_1@j)) | (!(is_m@i) & !(is_bos@j) & !(is_a@j) & !(is_b@j) & is_m@j & !(h1_1@j)))))
accept := (!(is_m@i) & h1_1@i & h2_1@i)

output := accept@i
evaluate at i = |w| (the final input position)