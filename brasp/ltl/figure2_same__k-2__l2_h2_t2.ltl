logic past-strict
alphabet a b m

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
is_m := sym(m)@i
h1_1 := (!((!(is_m@i) | (!(is_m@i) & !(is_b@j))))) S (((!(is_m@i) | (!(is_m@i) & !(is_b@j))) & ((is_bos@i & is_a@i & !(is_b@i) & is_m@i & !(is_bos@j) & !(is_a@j) & !(is_b@j) & is_m@j) | (!(is_m@i) & !(is_a@j) & !(is_b@j) & is_m@j))))
h1_2_seen := (!((!(is_bos@j) & !(is_m@j) & is_a@j))) S (((!(is_bos@j) & !(is_m@j) & is_a@j) & true))
h1_2_first := (!(h1_2_seen@i) & !(is_bos@i) & !(is_m@i) & is_a@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & !(is_m@i)))
h1_2_seen_1 := (!(((!(is_bos@j) & !(is_m@j) & is_a@j) | (!(is_bos@j) & !(is_m@j) & is_b@j)))) S ((((!(is_bos@j) & !(is_m@j) & is_a@j) | (!(is_bos@j) & !(is_m@j) & is_b@j)) & true))
h1_2_first_1 := (!(h1_2_seen_1@i) & ((!(is_bos@i) & !(is_m@i) & is_a@i) | (!(is_bos@i) & !(is_m@i) & is_b@i)))
h1_2_at_1 := (!(h1_2_first_1@j)) S ((h1_2_first_1@j & !(is_m@i)))
h1_2 := ((!(is_a@i) & !(is_m@i) & h1_2_at_1@i & is_b@i) | (h1_2_at@i & ((!(is_a@i) & !(is_b@i) & !(is_m@i)) | (!(is_m@i) & is_a@i))))
h2_1 := (!(true)) S ((true & (!(is_m@j) | (is_b@j & !(is_m@j) & h1_2@j))))
accept := ((h1_1@i & h1_2@i & !(h2_1@i)) | (!(is_m@i) & h1_1@i & h1_2@i & !(h2_1@i)))

output := accept@i
evaluate at i = |w| (the final input position)