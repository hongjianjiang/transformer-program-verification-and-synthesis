logic past-strict
alphabet a b m

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
is_m := sym(m)@i
h1_1 := (!((!(is_m@i) & !(is_bos@j)))) S (((!(is_m@i) & !(is_bos@j)) & (!(is_bos@i) & !(is_m@i) & !(is_bos@j) & !(is_a@j) & !(is_b@j) & is_m@j)))
h2_1 := (!((is_bos@i & !(is_a@i) & !(is_b@i) & is_m@i & !(h1_1@i) & is_bos@j & is_a@j & !(is_b@j) & !(h1_1@j)))) S (((is_bos@i & !(is_a@i) & !(is_b@i) & is_m@i & !(h1_1@i) & is_bos@j & is_a@j & !(is_b@j) & !(h1_1@j)) & (is_bos@i & !(is_a@i) & !(is_b@i) & is_m@i & !(h1_1@i) & is_bos@j & is_a@j & is_b@j & h1_1@j)))
h3_1 := (!((is_bos@i & !(is_a@i) & !(is_b@i) & is_m@i & !(h1_1@i) & h2_1@i & is_bos@j & !(is_a@j) & !(is_b@j) & !(is_m@j) & h1_1@j & h2_1@j))) S (((is_bos@i & !(is_a@i) & !(is_b@i) & is_m@i & !(h1_1@i) & h2_1@i & is_bos@j & !(is_a@j) & !(is_b@j) & !(is_m@j) & h1_1@j & h2_1@j) & (is_a@i & is_b@i & is_m@i & !(h1_1@i) & h2_1@i & is_b@j & !(is_m@j) & !(h1_1@j) & h2_1@j)))
h4_1 := (!((is_bos@i & is_b@i & is_m@i & !(h1_1@i) & h3_1@i & is_bos@j & is_a@j & is_b@j & !(is_m@j) & h1_1@j & h2_1@j & h3_1@j))) S (((is_bos@i & is_b@i & is_m@i & !(h1_1@i) & h3_1@i & is_bos@j & is_a@j & is_b@j & !(is_m@j) & h1_1@j & h2_1@j & h3_1@j) & (is_bos@i & !(is_a@i) & !(is_b@i) & is_m@i & !(h1_1@i) & h2_1@i & h3_1@i & is_bos@j & is_a@j & is_m@j & h1_1@j & h2_1@j)))
h5_1 := (!((!(is_m@i) & !(h3_1@i) & !(h4_1@i) & !(is_bos@j) & !(is_m@j) & h1_1@j))) S (((!(is_m@i) & !(h3_1@i) & !(h4_1@i) & !(is_bos@j) & !(is_m@j) & h1_1@j) & (h1_1@i & !(h2_1@i) & !(h3_1@i) & !(h4_1@i) & !(is_bos@j) & !(h3_1@j) & !(h4_1@j))))
accept := (!(is_bos@i) & !(is_m@i) & h1_1@i & !(h2_1@i) & !(h3_1@i) & !(h4_1@i) & h5_1@i)

output := accept@i
evaluate at i = |w| (the final input position)