logic past-strict
alphabet a b m

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
is_m := sym(m)@i
h1_1 := (!((is_bos@i & !(is_a@i) & is_b@i & is_m@i & is_bos@j & is_a@j & is_b@j & is_m@j))) S (((is_bos@i & !(is_a@i) & is_b@i & is_m@i & is_bos@j & is_a@j & is_b@j & is_m@j) & (is_bos@i & is_a@i & !(is_b@i) & is_m@i & is_bos@j & is_a@j & is_b@j & !(is_m@j))))
h1_2_seen := (!((is_a@j & is_b@j & is_bos@j & is_m@j))) S (((is_a@j & is_b@j & is_bos@j & is_m@j) & true))
h1_2_first := (!(h1_2_seen@i) & is_a@i & is_b@i & is_bos@i & is_m@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & (is_bos@i & !(is_a@i) & is_b@i & is_m@i & is_a@j & is_b@j & is_m@j)))
h1_2 := (h1_2_at@i & is_a@i & is_b@i & is_bos@i & is_m@i)
h2_1 := (!((!(h1_1@i) & !(h1_2@i) & !(is_bos@j) & !(is_m@j) & !(h1_1@j) & !(h1_2@j)))) S (((!(h1_1@i) & !(h1_2@i) & !(is_bos@j) & !(is_m@j) & !(h1_1@j) & !(h1_2@j)) & (!(h1_1@i) & !(h1_2@i) & !(is_bos@j) & !(h1_1@j) & !(h1_2@j))))
h2_2_seen := (!((!(h1_1@j) & !(is_bos@j) & !(is_m@j)))) S (((!(h1_1@j) & !(is_bos@j) & !(is_m@j)) & true))
h2_2_first := (!(h1_1@i) & !(h2_2_seen@i) & !(is_bos@i) & !(is_m@i))
h2_2_at := (!(h2_2_first@j)) S ((h2_2_first@j & (!(h1_1@i) & !(h1_2@i) & !(h1_1@j) & !(h1_2@j))))
h2_2 := (!(h1_1@i) & !(h1_2@i) & !(is_m@i) & h2_2_at@i)
h3_1 := (!((!(h1_1@i) & !(h1_2@i) & !(h1_2@j)))) S (((!(h1_1@i) & !(h1_2@i) & !(h1_2@j)) & (!(h1_2@i) & !(is_m@j) & !(h1_1@j) & !(h1_2@j))))
h3_2_seen := (!((!(h2_1@j) & !(h2_2@j) & !(is_m@j) & h1_1@j & h1_2@j & is_a@j & is_b@j))) S (((!(h2_1@j) & !(h2_2@j) & !(is_m@j) & h1_1@j & h1_2@j & is_a@j & is_b@j) & true))
h3_2_first := (!(h2_1@i) & !(h2_2@i) & !(h3_2_seen@i) & !(is_m@i) & h1_1@i & h1_2@i & is_a@i & is_b@i)
h3_2_at := (!(h3_2_first@j)) S ((h3_2_first@j & (is_bos@i & is_m@i & h1_2@i & h2_1@i & h2_2@i & is_b@j & is_m@j & h1_1@j & h1_2@j & h2_2@j)))
h3_2 := (!(h2_1@i) & !(h2_2@i) & h1_1@i & h1_2@i & h3_2_at@i & is_a@i & is_b@i & is_bos@i & is_m@i)
h4_2_seen := (!((!(h1_1@j) & !(h1_2@j) & !(h2_1@j) & !(h3_1@j) & !(h3_2@j) & !(is_b@j) & !(is_bos@j) & is_m@j))) S (((!(h1_1@j) & !(h1_2@j) & !(h2_1@j) & !(h3_1@j) & !(h3_2@j) & !(is_b@j) & !(is_bos@j) & is_m@j) & true))
h4_2_first := (!(h1_1@i) & !(h1_2@i) & !(h2_1@i) & !(h3_1@i) & !(h3_2@i) & !(h4_2_seen@i) & !(is_b@i) & !(is_bos@i) & is_m@i)
h4_2_at := (!(h4_2_first@j)) S ((h4_2_first@j & (!(h1_1@i) & !(h3_2@i) & !(h1_1@j) & !(h1_2@j) & !(h3_2@j))))
h4_2 := (!(h3_1@i) & !(h3_2@i) & h2_1@i & h2_2@i & h4_2_at@i)
accept := (!(is_bos@i) & !(is_m@i) & !(h1_1@i) & !(h1_2@i) & h2_2@i & !(h3_1@i) & !(h3_2@i) & h4_2@i)

output := accept@i
evaluate at i = |w| (the final input position)