logic past-strict
alphabet marker s0 s1

is_bos := bos@i
is_marker := sym(marker)@i
is_s0 := sym(s0)@i
is_s1 := sym(s1)@i
h1_1 := (!((is_marker@j & !(is_s0@j) & !(is_s1@j)))) S (((is_marker@j & !(is_s0@j) & !(is_s1@j)) & (is_marker@j & !(is_s0@j) & !(is_s1@j))))
accept := (!(is_bos@i) & h1_1@i)

output := accept@i
evaluate at i = |w| (the final input position)