logic past-strict
alphabet marker s0 s1 s2 s3

is_marker := sym(marker)@i
is_s0 := sym(s0)@i
is_s1 := sym(s1)@i
is_s2 := sym(s2)@i
is_s3 := sym(s3)@i
accept := (!((is_marker@j | !(((is_s0@i & is_s0@j) | (is_s1@i & is_s1@j) | (is_s2@i & is_s2@j) | (is_s3@i & is_s3@j)))))) S (((is_marker@j | !(((is_s0@i & is_s0@j) | (is_s1@i & is_s1@j) | (is_s2@i & is_s2@j) | (is_s3@i & is_s3@j)))) & is_marker@j))

output := accept@i
evaluate at i = |w| (the final input position)