logic past-strict
alphabet s0 s1

is_bos := bos@i
is_s0 := sym(s0)@i
is_s1 := sym(s1)@i
h1_1 := (!(((!(is_s0@i) & is_s1@i & is_bos@j & !(is_s0@j)) | (!(is_s0@i) & is_s1@i & !(is_s0@j))))) S ((((!(is_s0@i) & is_s1@i & is_bos@j & !(is_s0@j)) | (!(is_s0@i) & is_s1@i & !(is_s0@j))) & ((is_s1@i & !(is_s1@j)) | (is_bos@i & is_s0@i & is_bos@j & is_s0@j & !(is_s1@j)))))
h1_2_seen := (!((!(is_bos@j) & !(is_s1@j) & is_s0@j))) S (((!(is_bos@j) & !(is_s1@j) & is_s0@j) & true))
h1_2_first := (!(h1_2_seen@i) & !(is_bos@i) & !(is_s1@i) & is_s0@i)
h1_2_at := (!(h1_2_first@j)) S ((h1_2_first@j & ((is_s0@i & !(is_s1@i) & is_s0@j & !(is_s1@j)) | (!(is_s0@i) & is_s1@i & !(is_s0@j) & is_s1@j))))
h1_2_seen_1 := (!((!(is_bos@j) & !(is_s0@j) & is_s1@j))) S (((!(is_bos@j) & !(is_s0@j) & is_s1@j) & true))
h1_2_first_1 := (!(h1_2_seen_1@i) & !(is_bos@i) & !(is_s0@i) & is_s1@i)
h1_2_at_1 := (!(h1_2_first_1@j)) S ((h1_2_first_1@j & ((is_s0@i & !(is_s1@i) & is_s0@j & !(is_s1@j)) | (!(is_s0@i) & is_s1@i & !(is_s0@j) & is_s1@j))))
h1_2 := ((!(is_s0@i) & h1_2_at_1@i & is_s1@i) | (!(is_s1@i) & h1_2_at@i & is_s0@i))
h2_1 := (!(((is_s0@i & !(is_s1@i) & !(h1_2@i) & !(is_bos@j)) | (is_s0@i & !(is_s1@i) & !(h1_2@i) & is_s0@j & !(is_s1@j))))) S ((((is_s0@i & !(is_s1@i) & !(h1_2@i) & !(is_bos@j)) | (is_s0@i & !(is_s1@i) & !(h1_2@i) & is_s0@j & !(is_s1@j))) & ((!(is_s0@i) & is_s1@i & h1_1@i & !(h1_2@i) & is_bos@j & !(is_s0@j) & is_s1@j & h1_1@j & h1_2@j) | (is_s0@i & !(is_s1@i) & !(h1_2@i) & !(is_s0@j) & is_s1@j))))
h2_2_seen := (!((!(h1_1@j) & !(is_bos@j) & !(is_s0@j) & h1_2@j & is_s1@j))) S (((!(h1_1@j) & !(is_bos@j) & !(is_s0@j) & h1_2@j & is_s1@j) & true))
h2_2_first := (!(h1_1@i) & !(h2_2_seen@i) & !(is_bos@i) & !(is_s0@i) & h1_2@i & is_s1@i)
h2_2_at := (!(h2_2_first@j)) S ((h2_2_first@j & ((!(is_s0@i) & h1_1@i & is_s0@j & !(is_s1@j)) | (is_s0@i & !(is_s1@i) & !(h1_2@i) & !(h1_1@j) & h1_2@j))))
h2_2_seen_1 := (!((!(h1_1@j) & !(is_bos@j) & !(is_s1@j) & h1_2@j & is_s0@j))) S (((!(h1_1@j) & !(is_bos@j) & !(is_s1@j) & h1_2@j & is_s0@j) & true))
h2_2_first_1 := (!(h1_1@i) & !(h2_2_seen_1@i) & !(is_bos@i) & !(is_s1@i) & h1_2@i & is_s0@i)
h2_2_at_1 := (!(h2_2_first_1@j)) S ((h2_2_first_1@j & ((!(is_s0@i) & h1_1@i & is_s0@j & !(is_s1@j)) | (is_s0@i & !(is_s1@i) & !(h1_2@i) & !(h1_1@j) & h1_2@j))))
h2_2 := ((!(h1_2@i) & !(is_s0@i) & h1_1@i & h2_2_at_1@i & is_s1@i) | (!(h1_2@i) & !(is_s1@i) & h2_2_at@i & is_s0@i))
accept := (!(h1_1@i) & h1_2@i & !(h2_1@i) & !(h2_2@i))

output := accept@i
evaluate at i = |w| (the final input position)