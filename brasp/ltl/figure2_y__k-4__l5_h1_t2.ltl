logic past-strict
alphabet a b

is_bos := bos@i
is_a := sym(a)@i
is_b := sym(b)@i
h1_1 := (!((!(is_bos@j) | !(is_b@i)))) S (((!(is_bos@j) | !(is_b@i)) & (is_a@j & !(is_b@j))))
h2_1 := (!(((!(is_bos@j) & is_a@j & !(is_b@j)) | (!(is_bos@i) & !(is_bos@j))))) S ((((!(is_bos@j) & is_a@j & !(is_b@j)) | (!(is_bos@i) & !(is_bos@j))) & (!(is_bos@j) & h1_1@j)))
h3_1 := (!(true)) S ((true & h2_1@j))
h4_1 := (!(((h3_1@i & h3_1@j) | (!(h3_1@i) & !(h1_1@j))))) S ((((h3_1@i & h3_1@j) | (!(h3_1@i) & !(h1_1@j))) & ((!(h3_1@i) & !(is_b@j) & !(h1_1@j) & !(h2_1@j)) | !(h2_1@j))))
h5_1 := (!(((!(is_a@i) & is_b@i & h1_1@i & !(h3_1@i) & h4_1@i & !(is_bos@j) & !(is_a@j) & is_b@j) | (h4_1@i & !(is_bos@j))))) S ((((!(is_a@i) & is_b@i & h1_1@i & !(h3_1@i) & h4_1@i & !(is_bos@j) & !(is_a@j) & is_b@j) | (h4_1@i & !(is_bos@j))) & ((!(is_bos@i) & !(h3_1@i) & !(is_bos@j)) | (h4_1@i & !(is_bos@j)))))
accept := ((!(is_bos@i) & !(h4_1@i) & !(h5_1@i)) | (!(is_bos@i) & h3_1@i & !(h4_1@i) & !(h5_1@i)))

output := accept@i
evaluate at i = |w| (the final input position)