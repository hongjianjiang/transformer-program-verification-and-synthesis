logic past-strict
alphabet a b

bos_input := bos@i
symbol_1 := sym(b)@i
node_0 := (!(!(!(symbol_1@i)))) S ((!(!(symbol_1@i)) & bos_input@j))
node_2 := node_0@i
node_4_seen := (!(true)) S ((true & true))
node_4_first := !(node_4_seen@i)
node_4_at := (!(node_4_first@j)) S ((node_4_first@j & (!(bos_input@i) | (node_0@j | true))))
node_4_seen_1 := (!(node_0@j)) S ((node_0@j & true))
node_4_first_1 := (!(node_4_seen_1@i) & node_0@i)
node_4_at_1 := (!(node_4_first_1@j)) S ((node_4_first_1@j & (!(bos_input@i) | (node_0@j | true))))
node_4 := ((!(node_2@i) & node_4_at_1@i) | (node_2@i & node_4_at@i))

output := node_4@i
evaluate at i = |w| (the final input position)