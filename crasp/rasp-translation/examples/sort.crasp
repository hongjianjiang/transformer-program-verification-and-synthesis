ALPHABET: a b c d e sep eos

ViolUnique = #sep = 0 & (1 < #a | 1 < #b | 1 < #c | 1 < #d | 1 < #e)
ViolAll = sep & (#a < 1 | #b < 1 | #c < 1 | #d < 1 | #e < 1)
ViolSorted = #sep = 1 & ((b & #a < 2) | (c & #b < 2) | (d & #c < 2) | (e #d < 2))
Viol = ViolUnique | ViolSorted | ViolAll

SeenSep = #sep = 1
SeenEachCharTwice = #a = 2 & #b = 2 & #c = 2 & #d = 2 & #e = 2 
SeenEOS = 0 < #eos

Lang = SeenSep & SeenEachCharTwice & #Viol = 0 & SeenEOS

